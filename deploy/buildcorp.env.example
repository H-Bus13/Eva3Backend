# Copiar a /etc/buildcorp.env y completar en EC2, con permisos 600.
# Este ejemplo no contiene credenciales funcionales.
DJANGO_SETTINGS_MODULE=drf.settings_production
DJANGO_SECRET_KEY=REEMPLAZAR_CON_UNA_CLAVE_NUEVA
DJANGO_ALLOWED_HOSTS=REEMPLAZAR_CON_IP_O_DOMINIO
DJANGO_CSRF_TRUSTED_ORIGINS=https://REEMPLAZAR_CON_DOMINIO
DJANGO_HTTPS=true
PGDATABASE=buildcorp
PGUSER=buildcorp
PGPASSWORD=REEMPLAZAR_CON_CONTRASENA
PGHOST=127.0.0.1
PGPORT=5432
